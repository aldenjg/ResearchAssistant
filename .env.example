# Debate Research Agent System — environment variable template.
# Copy to .env and fill in real values. Never commit .env.

# --- LLM provider (required for live runs) ---------------------------------
# API key for the OpenAI-compatible LLM endpoint (read at call time; never hardcoded).
OPENAI_API_KEY=

# Optional override for the OpenAI-compatible base URL (default: https://api.openai.com/v1).
OPENAI_BASE_URL=

# Optional JSON object mapping routing aliases to your endpoint's model names.
# Defaults: {"mimo-v2.5-pro": "gpt-4.1", "mimo-v2.5": "gpt-4.1-mini",
#            "deepseek-v4-pro": "gpt-4.1", "deepseek-v4-flash": "gpt-4.1-mini"}
# Example: LLM_MODEL_MAP={"mimo-v2.5-pro": "gpt-4o", "mimo-v2.5": "gpt-4o-mini"}
LLM_MODEL_MAP=

# --- Search provider (required for live runs; pick one vendor) --------------
# Vendor: brave (default) or serper.
SEARCH_PROVIDER=

# API key for the Brave Search API (https://api.search.brave.com).
BRAVE_API_KEY=

# API key for the Serper API (https://serper.dev).
SERPER_API_KEY=

# --- Optional test/evaluation gates -----------------------------------------
# Set to 1 to enable optional live LLM integration tests. Normal tests are offline.
RUN_LLM_INTEGRATION_TESTS=

# Set to 1 to enable the optional live model comparison in evaluations.
RUN_LIVE_EVALUATIONS=
