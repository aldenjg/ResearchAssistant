# Debate Research Agent System — environment variable template.
# Copy to .env and fill in real values. Never commit .env.

# API key for the OpenAI-compatible LLM endpoint (read at call time; never hardcoded).
OPENAI_API_KEY=

# Optional override for the OpenAI-compatible base URL (default: https://api.openai.com/v1).
OPENAI_BASE_URL=

# Set to 1 to enable optional live LLM integration tests. Normal tests are offline.
RUN_LLM_INTEGRATION_TESTS=
